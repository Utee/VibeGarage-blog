
<div id="monetag-ad-container" class="monetag-ad-wrapper my-8 text-center py-4 bg-zinc-900/30 rounded-lg border border-zinc-800/40">
  <span class="text-[10px] uppercase tracking-widest text-zinc-500 block mb-2">Advertisement</span>
  
  <script is:inline>
    (function(s){
      s.dataset.zone='11480243';
      s.src='https://nap5k.com/tag.min.js';
      
      // Target the container directly instead of document.body
      var container = document.getElementById('monetag-ad-container');
      if (container) {
        container.appendChild(s);
      } else {
        (document.body || document.documentElement).appendChild(s);
      }
    })(document.createElement('script'));
  </script>
</div>