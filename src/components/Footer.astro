---
const today = new Date();
---

<footer>
	<div class="footer-content">
		<p>&copy; {today.getFullYear()} Vibe Garage. All rights reserved.</p>
		<div class="social-links">
			<a href="https://x.com/VibeGarage" target="_blank" rel="noopener noreferrer">
				X (Twitter)
			</a>
			<a href="https://instagram.com/vibegarage_entertainment" target="_blank" rel="noopener noreferrer">
				Instagram
			</a>
			<a href="https://facebook.com/VibeGarage" target="_blank" rel="noopener noreferrer">
				Facebook
			</a>
		</div>
	</div>
</footer>

<style>
	footer {
		padding: 2.5em 1em;
		background: var(--color-surface-dark);
		border-top: 1px solid var(--color-surface-border);
		color: var(--color-text-muted);
		text-align: center;
		margin-top: 4rem;
	}

	.footer-content {
		max-width: 960px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.8rem;
	}

	.social-links {
		display: flex;
		gap: 1.25rem;
	}

	.social-links a {
		color: var(--color-gold);
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 600;
		transition: color 0.2s ease;
	}

	.social-links a:hover {
		color: #ffffff;
	}
</style>