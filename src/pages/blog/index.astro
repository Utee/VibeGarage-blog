---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Calculate reading time roughly based on word count
function getReadingTime(content: string) {
	const wordsPerMinute = 200;
	const words = content ? content.split(/\s+/).length : 200;
	const minutes = Math.ceil(words / wordsPerMinute);
	return `${minutes} min read`;
}

const categories = [
	{ name: 'All Resources', id: 'all' },
	{ name: 'Artist Growth', id: 'artist-growth' },
	{ name: 'Music Marketing', id: 'music-marketing' },
	{ name: 'Monetization', id: 'monetization' },
	{ name: 'Streaming & Distribution', id: 'streaming-and-distribution' },
	{ name: 'Tutorials & Guides', id: 'tutorials-and-guides' },
	{ name: 'VibeGarage Updates', id: 'vibegarage-updates' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Knowledge Portal | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		
		<main class="portal-container">
			<!-- Header Banner -->
			<header class="portal-header">
				<div class="header-badge">RESOURCE DIRECTORY</div>
				<h1 class="portal-title">VibeGarage Knowledge Hub</h1>
				<p class="portal-subtitle">Explore guides, platform announcements, and growth strategies for independent creators.</p>
				
				<!-- Quick Search -->
				<div class="search-wrapper">
					<svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
					<input type="text" id="portal-search" placeholder="Search by title, tag, or topic..." />
				</div>
			</header>

			<!-- 2-Column App Layout -->
			<div class="portal-layout">
				<!-- Left Sticky Sidebar -->
				<aside class="sidebar">
					<div class="sidebar-group">
						<span class="sidebar-title">Categories</span>
						<nav class="sidebar-nav">
							{categories.map((cat, index) => (
								<button 
									class={`nav-item ${index === 0 ? 'active' : ''}`} 
									data-category={cat.name}
								>
									<span>{cat.name}</span>
									<span class="count-badge">
										{cat.id === 'all' 
											? posts.length 
											: posts.filter(p => p.data.category?.toLowerCase() === cat.name.toLowerCase()).length}
									</span>
								</button>
							))}
						</nav>
					</div>

					<div class="sidebar-box">
						<h3>Need Support?</h3>
						<p>Have questions about FanLink or payouts? Reach out directly.</p>
						<a href="mailto:support@vibegarage.app" class="sidebar-btn">Contact Support</a>
					</div>
				</aside>

				<!-- Right Main Content Feed -->
				<section class="feed-content">
					<div class="feed-header">
						<span class="feed-status">Showing <strong id="visible-count">{posts.length}</strong> articles</span>
					</div>

					<div class="feed-list">
						{posts.map((post) => (
							<article 
								class="feed-card"
								data-title={post.data.title.toLowerCase()}
								data-desc={post.data.description.toLowerCase()}
								data-category={post.data.category || ''}
								data-tags={(post.data.tags || []).join(' ').toLowerCase()}
							>
								<a href={`/blog/${post.id}/`} class="card-inner">
									<div class="card-main">
										<div class="card-meta">
											{post.data.category && <CategoryBadge category={post.data.category} />}
											<span class="meta-dot">•</span>
											<span class="meta-read">{getReadingTime(post.body || '')}</span>
											<span class="meta-dot">•</span>
											<span class="meta-date"><FormattedDate date={post.data.pubDate} /></span>
										</div>
										<h2 class="card-title">{post.data.title}</h2>
										<p class="card-excerpt">{post.data.description}</p>
										
										{post.data.tags && post.data.tags.length > 0 && (
											<div class="tag-list">
												{post.data.tags.map(tag => (
													<span class="tag-chip">#{tag}</span>
												))}
											</div>
										)}
									</div>
									<div class="card-action">
										<span class="read-btn">Read Article →</span>
									</div>
								</a>
							</article>
						))}
					</div>

					<div id="no-results" class="no-results hidden">
						<p>No matching guides or updates found.</p>
					</div>
				</section>
			</div>
		</main>

		<Footer />

		<script>
			const searchInput = document.getElementById('portal-search') as HTMLInputElement;
			const categoryBtns = document.querySelectorAll('.nav-item');
			const feedCards = document.querySelectorAll('.feed-card') as NodeListOf<HTMLElement>;
			const visibleCount = document.getElementById('visible-count');
			const noResults = document.getElementById('no-results');

			let activeCategory = 'All Resources';
			let searchQuery = '';

			function filterFeed() {
				let count = 0;

				feedCards.forEach((card) => {
					const title = card.getAttribute('data-title') || '';
					const desc = card.getAttribute('data-desc') || '';
					const category = card.getAttribute('data-category') || '';
					const tags = card.getAttribute('data-tags') || '';

					const matchesSearch = title.includes(searchQuery) || desc.includes(searchQuery) || tags.includes(searchQuery);
					const matchesCategory = activeCategory === 'All Resources' || category.toLowerCase() === activeCategory.toLowerCase();

					if (matchesSearch && matchesCategory) {
						card.style.display = 'block';
						count++;
					} else {
						card.style.display = 'none';
					}
				});

				if (visibleCount) visibleCount.textContent = count.toString();
				if (noResults) {
					if (count === 0) noResults.classList.remove('hidden');
					else noResults.classList.add('hidden');
				}
			}

			searchInput?.addEventListener('input', (e) => {
				searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
				filterFeed();
			});

			categoryBtns.forEach((btn) => {
				btn.addEventListener('click', () => {
					categoryBtns.forEach((b) => b.classList.remove('active'));
					btn.classList.add('active');
					activeCategory = btn.getAttribute('data-category') || 'All Resources';
					filterFeed();
				});
			});
		</script>
	</body>
</html>

<style>
	.portal-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2.5rem 1.5rem;
	}

	/* Header Styling */
	.portal-header {
		text-align: center;
		max-width: 700px;
		margin: 0 auto 3rem auto;
	}

	.header-badge {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--color-gold);
		letter-spacing: 0.12em;
		background: rgba(255, 184, 0, 0.1);
		padding: 0.35rem 0.85rem;
		border-radius: 20px;
		border: 1px solid rgba(255, 184, 0, 0.25);
		margin-bottom: 1rem;
	}

	.portal-title {
		font-size: 2.5rem;
		color: #ffffff;
		margin: 0 0 0.75rem 0;
		font-weight: 800;
	}

	.portal-subtitle {
		color: var(--color-text-muted);
		font-size: 1.05rem;
		line-height: 1.6;
		margin: 0 0 1.75rem 0;
	}

	.search-wrapper {
		position: relative;
		display: flex;
		align-items: center;
	}

	.search-icon {
		position: absolute;
		left: 1.25rem;
		color: var(--color-text-muted);
	}

	.search-wrapper input {
		width: 100%;
		padding: 0.9rem 1.25rem 0.9rem 3.25rem;
		background: var(--color-surface-dark);
		border: 1px solid var(--color-surface-border);
		border-radius: 8px;
		color: #ffffff;
		font-size: 0.95rem;
		outline: none;
		transition: border-color 0.2s, box-shadow 0.2s;
	}

	.search-wrapper input:focus {
		border-color: var(--color-gold);
		box-shadow: 0 0 0 3px rgba(255, 184, 0, 0.15);
	}

	/* Layout */
	.portal-layout {
		display: grid;
		grid-template-columns: 280px 1fr;
		gap: 2.5rem;
		align-items: start;
	}

	/* Sidebar */
	.sidebar {
		position: sticky;
		top: 2rem;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.sidebar-group {
		background: var(--color-surface-dark);
		border: 1px solid var(--color-surface-border);
		border-radius: 12px;
		padding: 1.25rem;
	}

	.sidebar-title {
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--color-text-muted);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		display: block;
		margin-bottom: 0.85rem;
	}

	.sidebar-nav {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.nav-item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		background: transparent;
		border: none;
		color: var(--color-text-muted);
		padding: 0.6rem 0.75rem;
		border-radius: 6px;
		font-size: 0.875rem;
		cursor: pointer;
		text-align: left;
		transition: background 0.15s, color 0.15s;
	}

	.nav-item:hover {
		background: rgba(255, 255, 255, 0.05);
		color: #ffffff;
	}

	.nav-item.active {
		background: var(--color-gold);
		color: #111111;
		font-weight: 600;
	}

	.nav-item.active .count-badge {
		background: rgba(0, 0, 0, 0.2);
		color: #111111;
	}

	.count-badge {
		font-size: 0.75rem;
		background: rgba(255, 255, 255, 0.08);
		padding: 0.15rem 0.5rem;
		border-radius: 12px;
		color: var(--color-text-muted);
	}

	.sidebar-box {
		background: linear-gradient(135deg, rgba(255, 184, 0, 0.05) 0%, rgba(0, 0, 0, 0.2) 100%);
		border: 1px solid var(--color-surface-border);
		border-radius: 12px;
		padding: 1.25rem;
	}

	.sidebar-box h3 {
		font-size: 1rem;
		color: #ffffff;
		margin: 0 0 0.35rem 0;
	}

	.sidebar-box p {
		font-size: 0.825rem;
		color: var(--color-text-muted);
		margin: 0 0 1rem 0;
		line-height: 1.5;
	}

	.sidebar-btn {
		display: inline-block;
		font-size: 0.825rem;
		font-weight: 600;
		color: var(--color-gold);
		text-decoration: none;
	}

	/* Feed Section */
	.feed-content {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.feed-header {
		font-size: 0.85rem;
		color: var(--color-text-muted);
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--color-surface-border);
	}

	.feed-header strong {
		color: #ffffff;
	}

	.feed-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.feed-card {
		background: var(--color-surface-dark);
		border: 1px solid var(--color-surface-border);
		border-radius: 12px;
		overflow: hidden;
		transition: transform 0.2s, border-color 0.2s;
	}

	.feed-card:hover {
		transform: translateY(-2px);
		border-color: var(--color-gold);
	}

	.card-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.5rem;
		text-decoration: none;
		color: inherit;
		gap: 1.5rem;
	}

	.card-main {
		flex-grow: 1;
	}

	.card-meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.6rem;
		font-size: 0.8rem;
		color: var(--color-text-muted);
	}

	.meta-dot {
		color: rgba(255, 255, 255, 0.2);
	}

	.card-title {
		font-size: 1.3rem;
		color: #ffffff;
		margin: 0 0 0.5rem 0;
		line-height: 1.35;
	}

	.card-excerpt {
		font-size: 0.9rem;
		color: var(--color-text-muted);
		margin: 0 0 1rem 0;
		line-height: 1.5;
	}

	.tag-list {
		display: flex;
		gap: 0.4rem;
		flex-wrap: wrap;
	}

	.tag-chip {
		font-size: 0.75rem;
		color: var(--color-text-muted);
		background: rgba(255, 255, 255, 0.04);
		padding: 0.2rem 0.5rem;
		border-radius: 4px;
	}

	.card-action {
		flex-shrink: 0;
	}

	.read-btn {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--color-gold);
		white-space: nowrap;
	}

	.no-results {
		text-align: center;
		padding: 4rem 0;
		color: var(--color-text-muted);
	}

	.hidden {
		display: none;
	}

	@media (max-width: 850px) {
		.portal-layout {
			grid-template-columns: 1fr;
		}

		.sidebar {
			position: static;
		}

		.card-inner {
			flex-direction: column;
			align-items: flex-start;
			gap: 1rem;
		}

		.card-action {
			align-self: flex-end;
		}
	}
</style>