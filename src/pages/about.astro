---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="container">
			<!-- Hero Section -->
			<section class="about-hero">
				<span class="badge">ABOUT THE BLOG</span>
				<h1>Where Artists Grow, Fans Discover, and Music Comes Alive</h1>
				<p class="subtitle">
					Empowering independent creators, producers, DJs, labels, and music fans.
				</p>
			</section>

			<!-- Core Story Content -->
			<section class="about-content">
				<div class="story-block">
					<p>
						The <strong>VibeGarage Blog</strong> is a trusted resource for independent artists, musicians, producers, DJs, record labels, content creators, and music fans looking to succeed in today's digital music industry. Our goal is to provide practical, easy-to-understand content that helps creators grow their audience, promote their music, earn from their work, and stay informed about the latest trends in music streaming and digital distribution.
					</p>
					<p>
						We publish articles covering music marketing, artist branding, fan engagement, streaming strategies, music business tips, platform updates, industry news, creator tools, and success stories from artists around the world. Whether you're releasing your first single or building a global fanbase, our content is designed to help you make smarter decisions and reach more listeners.
					</p>
					<p>
						As the official blog of VibeGarage, you'll also find announcements about new features, product updates, tutorials, and guides to help you get the most out of the VibeGarage platform. From creating a professional artist profile to understanding royalties, FanLink, audience growth, and digital promotion, we're here to support every stage of your music journey.
					</p>
					<p class="highlight-text">
						At VibeGarage, we believe that talent should never be limited by opportunity. Through education, innovation, and community, we're building a platform where creators can thrive and fans can discover amazing music from around the world.
					</p>
					<p>
						If you're passionate about music, creativity, and the future of independent artists, you've come to the right place. Welcome to the VibeGarage Blog.
					</p>
				</div>

				<!-- Connect Section -->
				<div class="connect-box">
					<h2>Join the VibeGarage Community</h2>
					<p>Follow our official channels to stay updated on new guides, platform features, and industry insights.</p>
					<div class="social-grid">
						<a href="https://x.com/VibeGarage" target="_blank" rel="noopener noreferrer" class="social-btn">
							X (Twitter) <span>@VibeGarage</span>
						</a>
						<a href="https://instagram.com/vibegarage_entertainment" target="_blank" rel="noopener noreferrer" class="social-btn">
							Instagram <span>@vibegarage_entertainment</span>
						</a>
						<a href="https://facebook.com/VibeGarage" target="_blank" rel="noopener noreferrer" class="social-btn">
							Facebook <span>VibeGarage</span>
						</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.container {
		max-width: 860px;
		margin: 0 auto;
		padding: 3rem 1rem;
	}

	/* Hero */
	.about-hero {
		text-align: center;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--color-surface-border);
		margin-bottom: 3rem;
	}

	.badge {
		display: inline-block;
		background: var(--color-maroon);
		color: #ffffff;
		font-weight: 700;
		font-size: 0.8rem;
		letter-spacing: 2px;
		padding: 0.35rem 1rem;
		border-radius: 4px;
		margin-bottom: 1rem;
		border: 1px solid rgba(243, 225, 120, 0.2);
	}

	.about-hero h1 {
		font-size: 2.4rem;
		line-height: 1.25;
		margin: 0.5rem 0;
		color: #ffffff;
	}

	.subtitle {
		font-size: 1.15rem;
		color: var(--color-text-muted);
		margin-top: 0.5rem;
	}

	/* Main Story */
	.story-block {
		background: var(--color-surface-dark);
		border: 1px solid var(--color-surface-border);
		padding: 2.5rem;
		border-radius: 8px;
		margin-bottom: 2.5rem;
	}

	.story-block p {
		line-height: 1.8;
		color: var(--color-text-main);
		font-size: 1.05rem;
		margin-bottom: 1.5rem;
	}

	.story-block p strong {
		color: var(--color-gold);
	}

	.story-block p.highlight-text {
		font-size: 1.15rem;
		font-weight: 600;
		color: #ffffff;
		border-left: 3px solid var(--color-gold);
		padding-left: 1.25rem;
		margin: 2rem 0;
	}

	.story-block p:last-child {
		margin-bottom: 0;
	}

	/* Connect Section */
	.connect-box {
		text-align: center;
		padding: 2.5rem 1.5rem;
		background: var(--color-surface-dark);
		border: 1px solid var(--color-surface-border);
		border-radius: 8px;
	}

	.connect-box h2 {
		color: #ffffff;
		margin-top: 0;
	}

	.connect-box p {
		color: var(--color-text-muted);
		margin-bottom: 1.5rem;
	}

	.social-grid {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
	}

	.social-btn {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 0.75rem 1.25rem;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid var(--color-surface-border);
		border-radius: 6px;
		color: var(--color-gold);
		text-decoration: none;
		font-weight: 700;
		transition: all 0.2s ease;
	}

	.social-btn span {
		font-size: 0.8rem;
		color: var(--color-text-muted);
		font-weight: 400;
		margin-top: 0.2rem;
	}

	.social-btn:hover {
		border-color: var(--color-gold);
		background: rgba(243, 225, 120, 0.05);
		transform: translateY(-2px);
	}
</style>