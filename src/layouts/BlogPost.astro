---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import InArticleAd from '../components/InArticleAd.astro';

type Props = CollectionEntry<'blog'>['data'] & {
    readTime?: string;
};

const { title, description, pubDate, updatedDate, heroImage, category } = Astro.props;

// Simple reading time calculation based on standard word count
const rawContent = await Astro.slots.render('default');
const wordCount = rawContent.replace(/<[^>]*>/g, '').split(/\s+/).length;
const readingMinutes = Math.ceil(wordCount / 200);
---

<html lang="en">
    <head>
        <BaseHead title={title} description={description} />
    </head>

    <body>
        <Header />
        <main class="container">
            <article class="post-article">
                <!-- Hero Image -->
                {heroImage && (
                    <div class="hero-image-wrapper">
                        <img src={heroImage} alt={title} />
                    </div>
                )}

                <!-- Post Header -->
                <header class="post-header">
                    <div class="meta-bar">
                        {category && <CategoryBadge category={category} />}
                        <span class="meta-item">
                            <FormattedDate date={pubDate} />
                        </span>
                        <span class="meta-divider">•</span>
                        <span class="meta-item">{readingMinutes} min read</span>
                    </div>

                    <h1 class="post-title">{title}</h1>
                    {updatedDate && (
                        <div class="last-updated">
                            Last updated on <FormattedDate date={updatedDate} />
                        </div>
                    )}
                </header>

                <!-- Main Post Content -->
                <div class="post-body">
                    <slot />
                </div>

                <!-- Non-intrusive Monetag In-Article Ad Unit -->
                <InArticleAd />

                <!-- VibeGarage Callout Box -->
                <section class="vibegarage-callout">
                    <div class="callout-icon">🚀</div>
                    <div class="callout-content">
                        <h3>Take Your Music Further with VibeGarage</h3>
                        <p>
                            Ready to build your fanbase, promote your releases, and manage your links all in one place? Join thousands of independent creators growing their music careers.
                        </p>
                        <a href="https://vibegarage.app" target="_blank" rel="noopener noreferrer" class="callout-btn">
                            Get Started Free →
                        </a>
                    </div>
                </section>
            </article>
        </main>
        <Footer />
    </body>
</html>

<style>
    .container {
        max-width: 780px;
        margin: 0 auto;
        padding: 3rem 1rem;
    }

    /* Hero Image */
    .hero-image-wrapper {
        margin-bottom: 2rem;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid var(--color-surface-border);
    }

    .hero-image-wrapper img {
        width: 100%;
        max-height: 420px;
        object-fit: cover;
        display: block;
    }

    /* Post Header */
    .post-header {
        margin-bottom: 2.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--color-surface-border);
    }

    .meta-bar {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }

    .meta-item {
        font-size: 0.85rem;
        color: var(--color-text-muted);
    }

    .meta-divider {
        color: var(--color-surface-border);
        font-size: 0.85rem;
    }

    .post-title {
        font-size: 2.5rem;
        line-height: 1.25;
        color: #ffffff;
        margin: 0;
    }

    .last-updated {
        font-size: 0.85rem;
        color: var(--color-text-muted);
        font-style: italic;
        margin-top: 0.5rem;
    }

    /* Content Styling */
    .post-body {
        color: var(--color-text-main);
        font-size: 1.1rem;
        line-height: 1.8;
    }

    .post-body :global(h2) {
        color: #ffffff;
        font-size: 1.75rem;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
    }

    .post-body :global(h3) {
        color: var(--color-gold);
        font-size: 1.35rem;
        margin-top: 2rem;
        margin-bottom: 0.75rem;
    }

    .post-body :global(p) {
        margin-bottom: 1.5rem;
    }

    .post-body :global(a) {
        color: var(--color-gold);
        text-decoration: underline;
    }

    .post-body :global(blockquote) {
        border-left: 3px solid var(--color-gold);
        background: var(--color-surface-dark);
        padding: 1rem 1.5rem;
        margin: 2rem 0;
        border-radius: 0 6px 6px 0;
        font-style: italic;
        color: #ffffff;
    }

    .post-body :global(code) {
        background: rgba(255, 255, 255, 0.08);
        padding: 0.2rem 0.4rem;
        border-radius: 4px;
        font-size: 0.9em;
    }

    /* VibeGarage CTA Callout Box */
    .vibegarage-callout {
        margin-top: 3.5rem;
        padding: 2rem;
        background: var(--color-surface-dark);
        border: 1px solid var(--color-surface-border);
        border-left: 4px solid var(--color-gold);
        border-radius: 8px;
        display: flex;
        gap: 1.5rem;
        align-items: flex-start;
    }

    .callout-icon {
        font-size: 2rem;
        line-height: 1;
    }

    .callout-content h3 {
        color: #ffffff;
        margin: 0 0 0.5rem 0;
        font-size: 1.3rem;
    }

    .callout-content p {
        color: var(--color-text-muted);
        font-size: 0.95rem;
        margin: 0 0 1.25rem 0;
        line-height: 1.6;
    }

    .callout-btn {
        display: inline-block;
        background: var(--color-gold);
        color: #111111;
        font-weight: 700;
        padding: 0.6rem 1.25rem;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.9rem;
        transition: transform 0.2s ease, background-color 0.2s ease;
    }

    .callout-btn:hover {
        transform: translateY(-2px);
        background: #ebd86a;
    }

    @media (max-width: 600px) {
        .vibegarage-callout {
            flex-direction: column;
        }
    }
</style>